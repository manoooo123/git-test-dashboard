# ============================================================================
# Pearls AQI Predictor — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is listed in .gitignore.
# ============================================================================

# ---- Data Provider API Keys ----

# OpenAQ v3 API key (required for live data collection)
# Obtain free key at: https://explore.openaq.org/
OPENAQ_API_KEY=your_openaq_api_key_here

# OpenWeatherMap API key (referenced in config/settings.py; not used by the
# active pipeline which uses the free Open-Meteo service instead)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ---- Feature Store (Optional — Hopsworks) ----

# Hopsworks API key (optional — project falls back to local CSV if absent)
# Obtain at: https://app.hopsworks.ai/
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT_NAME=pearls_aqi_predictor

# ---- Flask API Security ----

# Required: generate a secure random key, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_a_secure_random_hex_string

# Flask runtime settings
FLASK_PORT=5000
FLASK_DEBUG=false

# ---- Session Configuration ----
SESSION_VALIDITY_DAYS=7

# ---- Database ----
DATABASE_PATH=data/pearls_aqi.db

# ---- Application Settings ----
LOG_LEVEL=INFO
DEFAULT_CITY=Lahore

# ---- Auth Callback & Redirect Configuration ----
# Set PEARLS_STREAMLIT_URL to the origin where the Streamlit app is running.
# After any auth callback, the Flask /auth/callback route redirects here.
# For local development: http://localhost:8501
# For production: https://your-deployment-domain.com
PEARLS_STREAMLIT_URL=http://localhost:8501
APP_URL=http://localhost:8501
AUTH_REDIRECT_URL=http://localhost:8501

# ---- CORS (Optional) ----
# Comma-separated list of additional allowed CORS origins beyond localhost:8501/5000
# CORS_ALLOWED_ORIGINS=https://your-production-domain.com
