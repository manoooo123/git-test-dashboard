# ============================================================================
# Pearls AQI Predictor — .gitignore
# ============================================================================

# ---- Python Virtual Environments ----
venv/
.venv/
env/
ENV/

# ---- IDE & Editor Files ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Python Cache ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ---- Environment Variables & Secrets — NEVER COMMIT .env ----
.env
.env.*
!.env.example

# ---- Logs ----
logs/
*.log

# ---- Jupyter Notebook Cache ----
.ipynb_checkpoints/
*.ipynb

# ---- Raw & Processed Data (large, regenerated by pipelines) ----
data/raw/
data/processed/

# ---- Large Model Artifacts (use git-lfs or DVC for binaries > 50 MB) ----
# Root-level legacy duplicate RF models (374 MB each — never loaded by active code)
models/best_model_*.joblib
models/random_forest_*.joblib
# 3cities RF artifacts (>78 MB each — optionally track via git-lfs)
models/3cities/random_forest_*.joblib
# Forecasting folder large RF artifacts
models/forecasting/best_model_*.pkl
# Keep small Ridge + MLP artifacts (< 1 MB) and model registry JSON
!models/3cities/best_model_*.joblib
!models/3cities/ridge_*.joblib
!models/3cities/deep_learning_*.joblib
!models/forecasting/aqi_day_*.pkl
!models/forecasting/aqi_model_registry.json
!models/ridge_model.pkl

# ---- OS Generated Files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Build & Distribution ----
dist/
build/
*.egg-info/
*.egg
.eggs/

# ---- Test Cache ----
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ---- Misc ----
*.sqlite
*.db-journal
